// # 📄 Dosya Yolu: E:/Projects/TurkuazOffice/apps/desktop/src-tauri/tauri.conf.json5
// # 📌 Amac: Turkuaz Office Desktop Tauri pencere, build ve security konfigurasyonunu tanimlar
// # 📌 Modul - FileType: Config - JSON5
// # Version: 0.3.1
// # Aciklama: Windows/Linux suite launch, Start Menu kisayollari, main window, CSP ve capability secimini sabitler
// Bagimli Oldugu Katman: Config
{
  productName: "Turkuaz Office",
  version: "0.3.1",
  identifier: "com.turkuazlabs.office",
  build: {
    beforeDevCommand: "npm run dev",
    devUrl: "http://127.0.0.1:1420",
    beforeBuildCommand: "npm run build",
    frontendDist: "../dist",
  },
  app: {
    windows: [
      {
        label: "main",
        title: "Turkuaz Office",
        width: 1280,
        height: 820,
        minWidth: 900,
        minHeight: 620,
        resizable: true,
        fullscreen: false,
      },
    ],
    security: {
      capabilities: ["main-capability"],
      csp: "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      devCsp: "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'",
    },
  },
  bundle: {
    active: true,
    icon: ["icons/icon.png", "icons/icon.ico"],
    windows: {
      nsis: {
        startMenuFolder: "Turkuaz Office",
        installerHooks: "./windows/hooks.nsh",
      },
    },
    windows: {
      nsis: {
        startMenuFolder: "Turkuaz Office",
        installerHooks: "./windows/hooks.nsh",
      },
    },
    fileAssociations: [
      {
        ext: ["tko"],
        name: "Turkuaz Office Belgesi",
        description: "Turkuaz Office Belgesi",
        mimeType: "application/x-turkuaz-office",
      },
    ],
  },
}
